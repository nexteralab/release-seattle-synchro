{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "release-seattle-synchro",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Entry propio en vez de "@tanstack/react-start/server-entry": ese archivo
  // importa createStartHandler a través de dos `export *` que se rompen con
  // HMR. Ver el comentario en src/server.ts.
  "main": "./src/server.ts",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seattle-synchro-db",
      "database_id": "436d6810-4f00-4e55-86cb-bfe9505ad020",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "seattle-synchro-media"
    }
  ],

  // Solo configuración pública. OJO: `wrangler deploy` REEMPLAZA las vars del
  // worker con lo que haya aquí — cualquier variable de tipo "Texto" creada a
  // mano en el dashboard desaparece en el siguiente deploy.
  // Los secretos NO van aquí: se ponen como "Secreto" en el dashboard o con
  // `npx wrangler secret put`, y esos sí sobreviven a los deploys.
  //   Secretos requeridos: BETTER_AUTH_SECRET, RESEND_API_KEY
  //   En local, ambos salen de .dev.vars (gitignored).
  "vars": {
    "MEDIA_URL": "https://pub-899945239f104dcb964d2cb3d4abac38.r2.dev"
  }
}
